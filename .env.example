# === Lead Intelligence (качество) ===
LLM_ENABLED=true
# OpenAI-compatible (bardborn / OpenAI / OpenRouter)
LLM_BASE_URL=https://bardborn.lol/v1
LLM_API_KEY=sk-cvc-...

# Сильная модель (не mini ради копеек)
LLM_MODEL=gpt-5.5
# альтернативы на bardborn: claude-sonnet-5 | gpt-5.5 | deepseek-v4-pro

LLM_BATCH_SIZE=3
LLM_MAX_POSTS=50
LLM_TIMEOUT=180

PREMIUM_SCORE_THRESHOLD=70
PREMIUM_SCAN_ALL_CHATS=true
PREMIUM_CHAT_TOP_K=80
PREMIUM_MESSAGES_PER_CHAT=8000
PREMIUM_MAX_MSGS_PER_USER=60
PREMIUM_DISCOVER_OPEN=true
PREMIUM_DISCOVER_JOIN_MAX=8
